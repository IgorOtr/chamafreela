NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://chamalafree:chamalafree_dev@localhost:5434/chamalafree?schema=public
JWT_ACCESS_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-32-caracteres-ou-mais
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
SITE_URL=http://localhost:5173
# Cobrança real: mantenha false até aprovação comercial e integração do gateway
BILLING_ENABLED=false
# --- Asaas (gateway de pagamento). Ver docs/ASAAS.md. Sem estes valores, a cobrança permanece desativada.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# ASAAS_BASE_URL= (opcional; padrão conforme ASAAS_ENV)
# Swagger em produção só com ENABLE_DOCS=true
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SEED_SUPERADMIN_EMAIL=admin@chamalafree.local
SEED_SUPERADMIN_PASSWORD=Admin@12345
