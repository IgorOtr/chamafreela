generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x (x86_64) e linux-arm64-openssl-3.0.x (arm64) = funções da Vercel; native = máquina local
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão DIRETA (sem pooler) usada pelas migrations. Em produção, DATABASE_URL aponta para o pooler.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MODERADOR
  PROFISSIONAL
  EMPRESA
  CLIENTE
}

enum UserStatus {
  ATIVO
  PENDENTE
  SUSPENSO
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          Role
  status        UserStatus @default(ATIVO)
  consentAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  professional  Professional?
  company       Company?
  dataRequests  DataRequest[]
  notifications Notification[]
  simulations   Simulation[]
  brandKit      BrandKit?
  marketingAssets MarketingAsset[]
  subscriptions Subscription[]
  payments      Payment[]
  usageCounters UsageCounter[]
  billingCustomer BillingCustomer?
  notifyRecommendations Boolean @default(true)

  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionals Professional[]
  opportunities Opportunity[]
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum ProfessionalStatus {
  PENDENTE
  APROVADO
  REJEITADO
  OCULTO
}

enum AttendanceMode {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

enum MediaType {
  IMAGEM
  VIDEO
}

model Professional {
  id             String             @id @default(uuid())
  userId         String             @unique
  slug           String             @unique
  displayName    String
  categoryId     String
  headline       String?
  description    String
  city           String
  neighborhood   String?
  mode           AttendanceMode     @default(PRESENCIAL)
  radiusKm       Int                @default(10)
  whatsapp       String
  showContact    Boolean            @default(false)
  otherContacts  String?
  experience     String?
  qualifications String?
  available      Boolean            @default(true)
  preferences    String?
  status         ProfessionalStatus @default(PENDENTE)
  rejectionReason String?
  featured       Boolean            @default(false)
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category        @relation(fields: [categoryId], references: [id])
  services  Service[]
  areas     ServiceArea[]
  portfolio PortfolioItem[]
  interests Interest[]
  recommendations Recommendation[]

  @@index([status, featured])
  @@index([categoryId])
  @@index([city])
}

model Service {
  id             String   @id @default(uuid())
  professionalId String
  name           String
  description    String?
  priceInfo      String?
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([name])
}

model ServiceArea {
  id             String  @id @default(uuid())
  professionalId String
  city           String
  neighborhood   String?
  radiusKm       Int     @default(10)
  lat            Float?
  lng            Float?
  // Coluna gerada (PostGIS) a partir de lat/lng — ver migration. Usada nas consultas espaciais.
  location       Unsupported("geography(Point,4326)")?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([city])
}

model PortfolioItem {
  id             String    @id @default(uuid())
  professionalId String
  type           MediaType @default(IMAGEM)
  url            String
  caption        String?
  position       Int       @default(0)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

enum DataRequestType {
  ATUALIZACAO
  EXCLUSAO
}

enum DataRequestStatus {
  ABERTA
  CONCLUIDA
}

model DataRequest {
  id        String            @id @default(uuid())
  userId    String
  type      DataRequestType
  message   String?
  status    DataRequestStatus @default(ABERTA)
  createdAt DateTime          @default(now())
  resolvedAt DateTime?
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum CompanyStatus {
  ATIVA
  SUSPENSA
}

enum ContractType {
  PONTUAL
  RECORRENTE
  TEMPORARIO
  VAGA_FIXA
}

enum OpportunityStatus {
  PENDENTE
  PUBLICADA
  REJEITADA
  ENCERRADA
}

model Company {
  id              String        @id @default(uuid())
  userId          String        @unique
  tradeName       String
  legalName       String?
  cnpj            String?       @unique
  description     String?
  city            String
  phone           String
  website         String?
  responsibleName String
  responsibleRole String?
  status          CompanyStatus @default(ATIVA)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
}

model Opportunity {
  id              String            @id @default(uuid())
  companyId       String
  title           String
  description     String
  categoryId      String
  city            String
  neighborhood    String?
  mode            AttendanceMode    @default(PRESENCIAL)
  deadline        DateTime
  contractType    ContractType
  requirements    String?
  payMin          Int?
  payMax          Int?
  contactChannel  String
  status          OpportunityStatus @default(PENDENTE)
  rejectionReason String?
  flags           String[]
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  interests Interest[]
  recommendations Recommendation[]

  @@index([status, deadline])
  @@index([categoryId])
  @@index([companyId])
  @@index([city])
}

model Interest {
  id             String   @id @default(uuid())
  opportunityId  String
  professionalId String
  message        String?
  createdAt      DateTime @default(now())

  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, professionalId])
  @@index([professionalId])
}

model MatchConfig {
  id          String   @id
  weights     Json
  minScore    Int      @default(40)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Recommendation {
  id             String    @id @default(uuid())
  opportunityId  String
  professionalId String
  score          Int
  breakdown      Json
  justification  String
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, professionalId])
  @@index([professionalId, score])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Municipality {
  code      String   @id
  name      String
  uf        String   @default("RJ")
  centerLat Float?
  centerLng Float?
  geojson   Json?
  syncedAt  DateTime?
  createdAt DateTime @default(now())

  indicators TerritorialIndicator[]

  @@index([name])
}

model TerritorialIndicator {
  id             String   @id @default(uuid())
  municipalityCode String
  key            String
  dimension      String   @default("")
  dimensionLabel String?
  label          String
  value          Float?
  unit           String
  period         String
  source         String
  sourceUrl      String
  scale          String   @default("Município")
  methodology    String
  limitations    String
  fetchedAt      DateTime @default(now())

  municipality Municipality @relation(fields: [municipalityCode], references: [code], onDelete: Cascade)

  @@unique([municipalityCode, key, dimension, period])
  @@index([municipalityCode, key])
}

model Simulation {
  id           String   @id @default(uuid())
  userId       String
  name         String
  city         String?
  activity     String?
  inputs       Json
  assumptions  Json
  observed     Json
  results      Json
  modelVersion String
  seed         Int
  iterations   Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AssetType {
  LEGENDA
  PROMOCAO
  ROTEIRO_VIDEO
  ENQUETE
  DESCRICAO_SERVICO
  APRESENTACAO
  CARTAO
  POST
  STORY
  CALENDARIO
}

model BrandKit {
  id           String   @id @default(uuid())
  userId       String   @unique
  businessName String
  tagline      String?
  segment      String   @default("geral")
  city         String?
  mainService  String?
  differentiator String?
  contactLine  String?
  colors       Json
  fontKey      String   @default("moderna")
  logoConfig   Json
  logoSvg      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketingAsset {
  id        String    @id @default(uuid())
  userId    String
  type      AssetType
  title     String
  content   String    @default("")
  data      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model Plan {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  tagline         String
  priceCents      Int      @default(0)
  promoPriceCents Int?
  promoMonths     Int?
  promoNote       String?
  features        Json
  limits          Json     @default("{}")
  available       Boolean  @default(false)
  highlighted     Boolean  @default(false)
  active          Boolean  @default(true)
  position        Int      @default(0)
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDENTE
  ATIVA
  CANCELADA
  EXPIRADA
}

enum SubscriptionSource {
  MANUAL
  GATEWAY
}

enum PaymentStatus {
  PENDENTE
  PAGO
  FALHOU
  REEMBOLSADO
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String
  planCode    String
  status      SubscriptionStatus @default(ATIVA)
  source      SubscriptionSource @default(MANUAL)
  priceCents  Int                @default(0)
  startedAt   DateTime           @default(now())
  endsAt      DateTime?
  promoEndsAt DateTime?
  canceledAt  DateTime?
  gatewayRef  String?
  note        String?
  grantedById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planCode], references: [code])
  payments Payment[]

  @@index([userId, status])
  @@index([planCode, status])
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String
  userId         String
  amountCents    Int
  currency       String        @default("BRL")
  status         PaymentStatus @default(PENDENTE)
  method         String?
  gatewayRef     String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gatewayRef])
  @@index([userId, createdAt])
}

model UsageCounter {
  id        String   @id @default(uuid())
  userId    String
  key       String
  period    String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, period])
}

model SystemEvent {
  id        String   @id @default(uuid())
  level     String
  source    String
  message   String
  path      String?
  method    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Vínculo do usuário com o cliente no gateway (não guardamos CPF/CNPJ nem dados de cartão).
model BillingCustomer {
  id                String   @id @default(uuid())
  userId            String   @unique
  gateway           String
  gatewayCustomerId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gateway, gatewayCustomerId])
}

// Idempotência e trilha dos webhooks recebidos do gateway.
model WebhookEvent {
  id          String    @id @default(uuid())
  gateway     String
  eventId     String
  type        String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([gateway, eventId])
}
